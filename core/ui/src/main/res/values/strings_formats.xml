<?xml version="1.0" encoding="utf-8"?>
<!--
  Quantity- and format-dependent strings.

  These were the last inline literals: they interpolate values, so they need real format
  arguments rather than a straight text swap. Getting them into plurals matters more than
  the plain strings did — "1 device(s)" is wrong in English and unfixable in languages with
  more than two plural forms.
-->
<resources>

    <!-- Counts shown on cards and section headers -->
    <plurals name="count_devices">
        <item quantity="one">%d device</item>
        <item quantity="other">%d devices</item>
    </plurals>

    <plurals name="count_actions">
        <item quantity="one">%d action</item>
        <item quantity="other">%d actions</item>
